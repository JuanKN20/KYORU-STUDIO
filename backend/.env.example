DATABASE_URL=postgresql://POOLER_USER:PASSWORD@POOLER_HOST:6543/DATABASE?pgbouncer=true
DIRECT_URL=postgresql://MIGRATION_USER:PASSWORD@MIGRATION_HOST:5432/DATABASE
FRONTEND_ORIGIN=https://kyoru-studio.juann200213.workers.dev,http://localhost:5173,http://localhost:5174
ADMIN_API_TOKEN=change_me_in_production
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change_me_in_production
SUPABASE_STORAGE_BUCKET=yorurei-media
PORT=3001
NODE_ENV=development

# Producción:
# - Los valores DATABASE_URL y DIRECT_URL de arriba son solo marcadores de formato.
# - Copia ambas cadenas exactas desde el panel Connect del proyecto; no deduzcas host, región ni usuario.
# - DATABASE_URL usa el pooler transaccional de Supabase (puerto 6543) para el runtime.
# - DIRECT_URL usa para Prisma CLI la conexión directa o, si la red no admite IPv6, el pooler de sesión (puerto 5432).
# - En Render/Railway configura ambas variables.
# - Nunca subas contraseñas reales al repositorio.
